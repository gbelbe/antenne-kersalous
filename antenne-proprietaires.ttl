dos:m-sup-france-total a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Nombre de supports d'antennes au registre ANFR — France métropolitaine et outre-mer (périmètre du fichier ANFR)"@fr ; ant:valeur 72847 ; ant:unite "supports" ;
    ant:methode "Supports distincts (sup_id) du fichier ANFR du 2026-10-08, rattachés à l'ensemble par le département de la station (sta_nm_dpt)." ;
    ant:porteSurObjet dos:ens-france ;
    prov:wasDerivedFrom src:anfr-observatoire-20261008, src:anfr-sup-proprietaire ; prov:wasGeneratedBy src:act-proprietaires-anfr ;
    prov:wasAttributedTo src:claude ; prov:generatedAtTime "2026-10-15T00:00:00"^^xsd:dateTime .

dos:m-prop-france-73 a owl:NamedIndividual, ant:Mesure ;

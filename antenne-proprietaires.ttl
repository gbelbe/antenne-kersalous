# ═══════════════════════════════════════════════════════════════
#  SOCIÉTÉS DE PYLÔNES ET PROPRIÉTÉ DES SUPPORTS — Phoenix, France, Bretagne, Finistère
#  Fichier en partie généré (mesures et supports) à partir du fichier ANFR du 2026-10-08.
#  Les opérations (cessions, coentreprise) viennent de la presse, pas de l'ANFR.
# ═══════════════════════════════════════════════════════════════

# ── Sociétés ──
dos:phoenix-france a ant:SocietePylones ; ant:codeProprietaireAnfr 73 .
skt:prop-73 ant:designeEntreprise dos:phoenix-france .
dos:bouygues-telecom ant:coactionnaireDe dos:phoenix-france ;
    prov:wasDerivedFrom src:phoenix-site, src:telecompaper-jv .
dos:phoenix-tower-international a ant:SocietePylones ;
    note:note "Adossé à Blackstone ; majoritaire dans la coentreprise avec Bouygues Telecom, sans pourcentage publié (Telecompaper, 24 mars 2020)." ;
    prov:wasDerivedFrom src:telecompaper-jv .

dos:phoenix-france-2 a owl:NamedIndividual, ant:SocietePylones ;
    rdfs:label "Phoenix France Infrastructures 2"@fr ; ant:filialeDe dos:phoenix-tower-international ;
    note:note "Filiale de PTI qui a reçu en 2023 les 752 sites hébergeant Bouygues Telecom (TelecomTV). SIREN non relevé. Le code ANFR 73 est unique : on ne sait pas si l'ANFR y range aussi cette filiale." ;
    prov:wasDerivedFrom src:telecomtv-1978, src:recherche-entreprises .

dos:phoenix-tower-france a owl:NamedIndividual, ant:SocietePylones ;
    rdfs:label "Phoenix Tower France"@fr ; ant:filialeDe dos:phoenix-tower-international ;
    note:note "Troisième entité française retrouvée dans l'API Recherche d'entreprises. Rôle exact non établi." ;
    prov:wasDerivedFrom src:recherche-entreprises .

dos:infracos a owl:NamedIndividual, ant:Entreprise ;
    rdfs:label "Infracos"@fr ;
    note:note "Coentreprise de Bouygues Telecom et SFR portant environ 3 700 sites en zones de densité moyenne ; rachetée par PTI, clôture annoncée le 24 décembre 2025." ;
    prov:wasDerivedFrom src:dcd-infracos .
dos:bouygues-telecom ant:coactionnaireDe dos:infracos .
dos:operateur-sfr ant:coactionnaireDe dos:infracos .
dos:cellnex-france a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "Cellnex"@fr ; ant:codeProprietaireAnfr 68 .
skt:prop-68 ant:designeEntreprise dos:cellnex-france .
dos:hivory a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "Hivory"@fr ; ant:codeProprietaireAnfr 72 .
skt:prop-72 ant:designeEntreprise dos:hivory .
dos:totem a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "Totem"@fr ; ant:codeProprietaireAnfr 74 .
skt:prop-74 ant:designeEntreprise dos:totem .
dos:tdf a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "TDF"@fr ; ant:codeProprietaireAnfr 32 .
skt:prop-32 ant:designeEntreprise dos:tdf .
dos:atc-france a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "ATC France"@fr ; ant:codeProprietaireAnfr 65 .
skt:prop-65 ant:designeEntreprise dos:atc-france .
dos:on-tower-france a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "On Tower France"@fr ; ant:codeProprietaireAnfr 75 .
skt:prop-75 ant:designeEntreprise dos:on-tower-france .
dos:towercast a owl:NamedIndividual, ant:SocietePylones ; rdfs:label "Towercast"@fr ; ant:codeProprietaireAnfr 33 .
skt:prop-33 ant:designeEntreprise dos:towercast .
dos:cellnex-france note:note "Cellnex a racheté Hivory ; la cession de sites à PTI en 2023 est présentée comme une mesure corrective de l'Autorité de la concurrence (résumés de presse)." .

# ── Opérations ──
dos:op-jv-2020 a owl:NamedIndividual, ant:OperationSurSites ;
    rdfs:label "Coentreprise PTI / Bouygues Telecom : environ 4 000 nouveaux pylônes sur 12 ans (annonce du 24 mars 2020)"@fr ; ant:dateEvenement "2020-03-24"^^xsd:date ; ant:acquereur dos:phoenix-france ;
    ant:nombreSites 4000 ;
    prov:wasDerivedFrom src:telecompaper-jv, src:phoenix-site ; prov:wasGeneratedBy src:act-recherche-operations ;
    note:note "Programme de **construction** hors zones très denses, donc surtout les zones périurbaines et rurales : c'est le canal le plus probable de Kersalous. PTI majoritaire, parts non publiées. Le chiffre est un objectif sur 12 ans, pas un parc existant." .

dos:op-sfr-2023 a owl:NamedIndividual, ant:OperationSurSites ;
    rdfs:label "Reprise de 1 226 sites hébergeant SFR (annonce du 4 septembre 2023)"@fr ; ant:dateEvenement "2023-09-04"^^xsd:date ; ant:acquereur dos:phoenix-tower-international ;
    ant:cedant dos:cellnex-france ;
    ant:nombreSites 1226 ;
    prov:wasDerivedFrom src:telecomtv-1978, src:universfreebox-1978 ; prov:wasGeneratedBy src:act-recherche-operations ;
    note:note "Filiale 100 % PTI non nommée. Le vendeur n'est pas nommé dans l'article TelecomTV (qui cite Cellnex, Bouygues Telecom et SFR comme interlocuteurs) ; Cellnex comme cédant et le lien avec les mesures correctrices de l'Autorité de la concurrence viennent de résumés de presse, à vérifier." .

dos:op-bouygues-2023 a owl:NamedIndividual, ant:OperationSurSites ;
    rdfs:label "Reprise de 752 sites hébergeant Bouygues Telecom, via Phoenix France Infrastructures 2 (annonce du 4 septembre 2023)"@fr ; ant:dateEvenement "2023-09-04"^^xsd:date ; ant:acquereur dos:phoenix-france-2 ;
    ant:nombreSites 752 ;
    prov:wasDerivedFrom src:telecomtv-1978, src:universfreebox-1978 ; prov:wasGeneratedBy src:act-recherche-operations ;
    note:note "Cédant non nommé par la source. Avec l'opération SFR, le parc français annoncé passe à plus de 3 600 sites, objectif de plus de 5 000 sous deux ans." .

dos:op-infracos-2025 a owl:NamedIndividual, ant:OperationSurSites ;
    rdfs:label "Rachat d'Infracos, environ 3 700 sites de Bouygues Telecom et SFR (clôture annoncée le 24 décembre 2025)"@fr ; ant:dateEvenement "2025-12-24"^^xsd:date ; ant:acquereur dos:phoenix-tower-international ;
    ant:cedant dos:bouygues-telecom ;
    ant:cedant dos:operateur-sfr ;
    ant:nombreSites 3700 ;
    prov:wasDerivedFrom src:dcd-infracos, src:anp-infracos ; prov:wasGeneratedBy src:act-recherche-operations ;
    note:note "Négociations exclusives annoncées le 30 juillet 2025, après appel d'offres ; approbations de l'Autorité de la concurrence, de l'ARCEP et du ministre de l'Économie requises. Valeur d'entreprise de 870 M€ citée par une note juridique avant clôture ; termes financiers non publiés à la clôture. Parc français annoncé : près de 10 000 sites, programmes de construction compris. **Correction** : une réponse antérieure de l'assistant datait ce rachat de 2024 ; c'était faux." .


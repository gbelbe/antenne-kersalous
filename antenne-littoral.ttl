    skos:narrower skt:ll-29001, skt:ll-29003, skt:ll-29006, skt:ll-29008, skt:ll-29017, skt:ll-29019, skt:ll-29021, skt:ll-29022, skt:ll-29023, skt:ll-29028, skt:ll-29030, skt:ll-29031, skt:ll-29032, skt:ll-29037, skt:ll-29039, skt:ll-29040, skt:ll-29042, skt:ll-29043, skt:ll-29044, skt:ll-29045, skt:ll-29046, skt:ll-29053, skt:ll-29056, skt:ll-29057, skt:ll-29058, skt:ll-29063, skt:ll-29064, skt:ll-29072, skt:ll-29073, skt:ll-29075, skt:ll-29077, skt:ll-29078, skt:ll-29079, skt:ll-29080, skt:ll-29082, skt:ll-29083, skt:ll-29084, skt:ll-29085, skt:ll-29090, skt:ll-29091, skt:ll-29098, skt:ll-29099, skt:ll-29101, skt:ll-29103, skt:ll-29104, skt:ll-29109, skt:ll-29112, skt:ll-29117, skt:ll-29120, skt:ll-29130, skt:ll-29132, skt:ll-29133, skt:ll-29135, skt:ll-29137, skt:ll-29140, skt:ll-29150, skt:ll-29151, skt:ll-29153, skt:ll-29155, skt:ll-29158, skt:ll-29165, skt:ll-29166, skt:ll-29168, skt:ll-29171, skt:ll-29172, skt:ll-29176, skt:ll-29177, skt:ll-29178, skt:ll-29184, skt:ll-29185, skt:ll-29186, skt:ll-29188, skt:ll-29189, skt:ll-29190, skt:ll-29192, skt:ll-29195, skt:ll-29196, skt:ll-29197, skt:ll-29198, skt:ll-29201, skt:ll-29206, skt:ll-29212, skt:ll-29214, skt:ll-29215, skt:ll-29217, skt:ll-29218, skt:ll-29220, skt:ll-29221, skt:ll-29225, skt:ll-29226, skt:ll-29228, skt:ll-29235, skt:ll-29236, skt:ll-29238, skt:ll-29239, skt:ll-29240, skt:ll-29251, skt:ll-29252, skt:ll-29254, skt:ll-29256, skt:ll-29257, skt:ll-29259, skt:ll-29273, skt:ll-29276, skt:ll-29279, skt:ll-29280, skt:ll-29282, skt:ll-29284, skt:ll-29287, skt:ll-29289, skt:ll-29290, skt:ll-29292, skt:ll-29293, skt:ll-29298, skt:ll-29302 .


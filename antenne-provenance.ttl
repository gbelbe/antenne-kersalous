src:apicarto-gpu a owl:NamedIndividual, src:JeuDeDonnees ;
    prov:generatedAtTime "2026-09-15"^^xsd:date ;
    src:dateDonnees "document d'urbanisme DU_29174 ; assiettes SUP publiées au GPU le 2026-01-20" ;

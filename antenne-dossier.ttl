# ── Mesures ────────────────────────────────────────────────────

dos:m-dist-maison1 a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → habitation 1 : 23 m"@fr ;
    ant:valeur 23 ; ant:unite "m" ; ant:methode "IGN BD TOPO, distance au bord de parcelle" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:maison-1 .

dos:m-dist-maison2 a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → habitation 2 : 32 m"@fr ;
    ant:valeur 32 ; ant:unite "m" ; ant:methode "IGN BD TOPO" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:maison-2 .

dos:m-dist-zone-humide a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → zone humide : 8 m"@fr ;
    ant:valeur 8 ; ant:unite "m" ; ant:methode "APIcarto GPU, prescriptions surfaciques" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:zone-humide-voisine .

dos:m-dist-ebc a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → EBC : 34 m"@fr ;
    ant:valeur 34 ; ant:unite "m" ; ant:methode "APIcarto GPU" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:ebc-voisin .

dos:m-dist-abords a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance parcelle → périmètre des abords : 163 m"@fr ;
    ant:valeur 163 ; ant:unite "m" ; ant:methode "APIcarto GPU, assiette SUP AC1" ;
    ant:porteSurObjet dos:parcelle-yx26 ; ant:parRapportA dos:abords-trevilit ;
    note:note "Mesure défavorable, à connaître avant de plaider le patrimoine : la parcelle est **hors** périmètre." .

dos:m-dist-manoir a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Distance manoir → bord de parcelle : 648 m"@fr ;
    ant:valeur 648 ; ant:unite "m" ; ant:methode "calcul géodésique sur géométries IGN" ;
    ant:porteSurObjet dos:mh-trevilit ; ant:parRapportA dos:parcelle-yx26 .

dos:m-covisibilite a owl:NamedIndividual, ant:Mesure ;
    rdfs:label "Covisibilité manoir ↔ parcelle : directe"@fr ;
    ant:valeur 1 ; ant:unite "booléen" ;
    ant:methode "Profil IGN RGE ALTI, 31 points : parcelle à 25,8 m NGF, manoir à 21,6 m NGF, aucun obstacle de relief. Modèle de terrain nu : la végétation n'est pas prise en compte." ;
    ant:porteSurObjet dos:mh-trevilit ; ant:parRapportA dos:parcelle-yx26 .

# ═══════════════════════════════════════════════════════════════
#  PROJET
# ═══════════════════════════════════════════════════════════════

dos:projet-pylone a owl:NamedIndividual, ant:ProjetAntenne ;
    rdfs:label "Relais radioélectrique de Kersalous"@fr ;
    ant:implanteSur dos:parcelle-yx26 ;
    geo:asWKT "POINT(-4.274491 47.874985)"^^geo:wktLiteral ;
    ant:comprendOuvrage dos:ouvrage-pylone, dos:ouvrage-zone-technique, dos:ouvrage-cloture .

dos:ouvrage-pylone a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Pylône treillis 30 m"@fr ; ant:hauteur 30 .

dos:ouvrage-zone-technique a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Zone technique sur dalle béton"@fr ;
    note:note "**Emprise au sol inconnue** — case laissée vide sur l'avis de dépôt. C'est la donnée la plus importante du dossier : au-delà de 20 m², un permis de construire est obligatoire et la DP est illégale." .

dos:ouvrage-cloture a owl:NamedIndividual, ant:Ouvrage ;
    rdfs:label "Clôture grillagée RAL 6005, 2 m"@fr ; ant:hauteur 2 .


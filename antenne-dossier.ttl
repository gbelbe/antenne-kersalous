#  ACTEURS
# ═══════════════════════════════════════════════════════════════

dos:role-proprietaire a owl:NamedIndividual, ant:Role ; rdfs:label "Propriétaire"@fr .
dos:role-bailleur    a owl:NamedIndividual, ant:Role ; rdfs:label "Bailleur"@fr .
dos:role-exploitant  a owl:NamedIndividual, ant:Role ; rdfs:label "Exploitant agricole"@fr .
dos:role-riverain    a owl:NamedIndividual, ant:Role ; rdfs:label "Riverain"@fr .
dos:role-demandeur   a owl:NamedIndividual, ant:Role ; rdfs:label "Demandeur"@fr .
dos:role-autorite    a owl:NamedIndividual, ant:Role ; rdfs:label "Autorité décisionnaire"@fr .
dos:role-conseil     a owl:NamedIndividual, ant:Role ; rdfs:label "Conseil juridique"@fr .
dos:role-requerant   a owl:NamedIndividual, ant:Role ; rdfs:label "Requérant potentiel"@fr .

dos:phoenix-france a owl:NamedIndividual, ant:Entreprise ;
    rdfs:label "Phoenix France Infrastructures"@fr ; ant:siren "853958650" ;
    ant:aRole dos:role-demandeur ; ant:representantLegal dos:personne-culver ;
    ant:filialeDe dos:phoenix-tower-international ;
    note:note "SAS, siège 4 rue de Marivaux 75002 Paris. CA 2024 : 40,9 M€, résultat net +17,2 M€. Coentreprise Phoenix Tower International / Bouygues Telecom créée en mars 2020." .

dos:phoenix-tower-international a owl:NamedIndividual, ant:Entreprise ;
    rdfs:label "Phoenix Tower International"@fr ;
    note:note "Groupe américain, siège à Boca Raton (Floride). Plus de 3 600 sites en France." .

dos:bouygues-telecom a owl:NamedIndividual, ant:Entreprise ;
    rdfs:label "Bouygues Telecom"@fr ; ant:siren "397480930" ;
    note:note "Coactionnaire. L'adresse du demandeur sur l'avis de dépôt (76 rue des Français Libres à Nantes) est en réalité son agence Ouest." .

dos:personne-culver a owl:NamedIndividual, ant:Personne ;
    rdfs:label "Timothy Culver"@fr ;
    note:note "Nommé comme demandeur sur l'avis de dépôt. Executive Chairman de Phoenix Tower International ; ancien président du conseil de surveillance de PFI au registre français." .

dos:proprietaire-yx26 a owl:NamedIndividual, ant:Personne ;
    rdfs:label "Propriétaire de la parcelle YX 26 — à identifier"@fr ;
    ant:aRole dos:role-proprietaire, dos:role-bailleur ;
    ant:estProprietaireDe dos:parcelle-yx26 ;
    note:note """**Inconnu modélisé volontairement.**
Aucune mutation dans DVF entre 2021 et 2025 : la parcelle n'a pas été vendue récemment.
Hypothèse la plus probable : bail de longue durée consenti par le propriétaire en place.
À identifier par l'extrait de matrice cadastrale (6815-EM-SD) puis le 3233-SD.
Données personnelles : ne pas publier, ne pas diffuser le nom.""" .

dos:exploitant-yx26 a owl:NamedIndividual, ant:Personne ;
    rdfs:label "Exploitant agricole de la parcelle — à vérifier"@fr ;
    ant:aRole dos:role-exploitant ; ant:exploite dos:parcelle-yx26 ;
    note:note "S'il existe un bail rural, la résiliation partielle (L.411-32 c. rural) peut être contestée devant le tribunal paritaire. Levier sous-utilisé." .

dos:proprietaire-manoir a owl:NamedIndividual, ant:Personne ;
    rdfs:label "Propriétaire du Manoir de Trévilit"@fr ;
    ant:aRole dos:role-proprietaire, dos:role-requerant .

dos:vous a owl:NamedIndividual, ant:Personne ;
    rdfs:label "Vous (porteur du dossier)"@fr ; ant:aRole dos:role-riverain, dos:role-requerant .

dos:mairie-ploneour a owl:NamedIndividual, ant:Administration ;
    rdfs:label "Mairie de Plonéour-Lanvern"@fr ; ant:aRole dos:role-autorite ;
    note:note "mairie@ploneour-lanvern.fr — 02 98 82 66 00 — lun-ven 8h30-12h / 13h30-17h45, sam 8h30-12h." .

dos:udap-29 a owl:NamedIndividual, ant:Administration ;
    rdfs:label "UDAP du Finistère (ABF)"@fr ;
    note:note "Hors périmètre des abords, son avis n'est pas requis — mais il peut être sollicité à titre simple, et pèse lourd en contentieux." .

dos:spf-quimper a owl:NamedIndividual, ant:Administration ;
    rdfs:label "Service de la publicité foncière — Quimper"@fr ;
    note:note "spf.quimper@dgfip.finances.gouv.fr — 3 bd du Finistère, 29107 Quimper Cedex. Formulaire 3233-SD, 12 € par immeuble, réponse par courriel gratuite." .

dos:sdif-chateaulin a owl:NamedIndividual, ant:Administration ;
    rdfs:label "SDIF Finistère — Châteaulin"@fr ;
    note:note "sdif29.chateaulin@dgfip.finances.gouv.fr — formulaire 6815-EM-SD, gratuit." .

dos:safer-bretagne a owl:NamedIndividual, ant:Administration ;
    rdfs:label "SAFER Bretagne"@fr ;
    note:note "Notifiée de toute vente de terrain agricole. Sait si la parcelle a changé de mains." .

dos:prefecture-29 a owl:NamedIndividual, ant:Administration ;
    rdfs:label "Préfecture du Finistère"@fr ;
    note:note "Peut déférer au tribunal administratif une décision de non-opposition illégale." .

dos:ta-rennes a owl:NamedIndividual, ant:Juridiction ; rdfs:label "Tribunal administratif de Rennes"@fr .
dos:cada a owl:NamedIndividual, ant:Juridiction ; rdfs:label "CADA"@fr ;
    note:note "Saisine possible dans les 2 mois suivant un refus, exprès ou tacite, de communication." .

dos:sites-et-monuments a owl:NamedIndividual, ant:Association ;
    rdfs:label "Sites & Monuments (SPPEF)"@fr ; ant:aRole dos:role-requerant ;
    note:note "Association ancienne, donc recevable au regard de L.600-1-1 — contrairement à une association créée aujourd'hui. Plaide régulièrement les dossiers antenne / covisibilité." .

# ═══════════════════════════════════════════════════════════════
#  CORPUS JURIDIQUE
# ═══════════════════════════════════════════════════════════════

dos:art-r421-9 a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. urb. art. R. 421-9"@fr ; ant:reference "R. 421-9" ;
    note:note "DP si surface de plancher **et** emprise au sol > 5 m² et ≤ 20 m². Au-delà de 20 m², permis de construire obligatoire." .
dos:art-r600-1 a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. urb. art. R. 600-1"@fr ; ant:reference "R. 600-1" ;
    note:note "Notification du recours par LRAR à l'auteur de la décision **et** au bénéficiaire, dans les 15 jours. À peine d'irrecevabilité." .
dos:art-r600-2 a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. urb. art. R. 600-2"@fr ; ant:reference "R. 600-2" ;
    note:note "Recours dans les 2 mois à compter du premier jour d'un affichage continu de 2 mois sur le terrain." .
dos:art-r111-27 a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. urb. art. R. 111-27"@fr ; ant:reference "R. 111-27" ;
    note:note "Atteinte au caractère ou à l'intérêt des lieux avoisinants. Le juge peut tenir compte d'un monument situé hors périmètre." .
dos:art-l151-23 a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. urb. art. L. 151-23"@fr ; ant:reference "L. 151-23" .
dos:art-l424-5 a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. urb. art. L. 424-5"@fr ; ant:reference "L. 424-5" ;
    note:note "Retrait d'une décision illégale possible dans les 3 mois." .
dos:art-l311-9-crpa a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "CRPA art. L. 311-9"@fr ; ant:reference "L. 311-9" ;
    note:note "Le demandeur choisit la modalité : consultation sur place, copie, ou envoi électronique gratuit." .
dos:art-l621-30-patrimoine a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. patrimoine art. L. 621-30"@fr ; ant:reference "L. 621-30" ;
    note:note "Depuis la loi LCAP de 2016, le périmètre des abords remplace le champ de visibilité : hors périmètre, aucun contrôle de l'ABF." .
dos:art-l411-32-rural a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "C. rural art. L. 411-32"@fr ; ant:reference "L. 411-32" .
dos:art-l34-9-1-cpce a owl:NamedIndividual, ant:ArticleDeCode ;
    rdfs:label "CPCE art. L. 34-9-1"@fr ; ant:reference "L. 34-9-1" ;
    note:note "Dossier d'information transmis au maire, et simulation d'exposition aux ondes à sa demande." .

dos:plu-regle-a-i-2-3 a owl:NamedIndividual, ant:RegleDeZone ;
    rdfs:label "PLU Plonéour-Lanvern — art. A I-2 §3"@fr ;
    note:note "Équipements d'intérêt collectif admis en zone A seulement s'ils ne sont pas incompatibles avec l'activité agricole de l'unité foncière **et** ne portent pas atteinte aux espaces naturels et aux paysages. Double condition cumulative : c'est là que se joue le fond." .

dos:plu-art-6 a owl:NamedIndividual, ant:RegleDeZone ;
    rdfs:label "PLU Plonéour-Lanvern — art. 6, éléments paysagers"@fr ;
    note:note "Toute suppression de haie ou de talus protégé exige une DP distincte, examinée par une commission créée par le maire, qui peut refuser ou imposer des compensations." .

dos:ce-2011-ondes a owl:NamedIndividual, ant:Jurisprudence ;
    rdfs:label "CE, 26 octobre 2011 — police des ondes"@fr ;
    note:note "La police des ondes relève exclusivement de l'État. Un refus fondé sur la santé est illégal : ce moyen est perdu d'avance en contentieux d'urbanisme." .

# ═══════════════════════════════════════════════════════════════
#  DOCUMENTS
# ═══════════════════════════════════════════════════════════════

dos:doc-avis-depot a owl:NamedIndividual, ant:Document ;
    rdfs:label "Avis de dépôt affiché en mairie"@fr ; ant:natureDocument skt:doc-avis-depot ;
    note:note "Détenu (photographie). Cases emprise au sol, surface de plancher, hauteur et zonage laissées vides." .

dos:doc-dossier-dp a owl:NamedIndividual, ant:Document ;
    rdfs:label "Dossier complet de la DP (pièces DP1 à DP8)"@fr ; ant:natureDocument skt:doc-plan ;
    note:note "**À obtenir — pièce maîtresse.** Contient l'emprise au sol, les photomontages, l'attestation de propriété et l'attestation de mandat." .

dos:doc-panneau a owl:NamedIndividual, ant:Document ;
    rdfs:label "Panneau d'affichage sur le terrain"@fr ; ant:natureDocument skt:doc-panneau ;
    note:note "À photographier daté, chaque semaine, dès son apparition. Un panneau absent ou incomplet ne déclenche pas le délai de recours." .

dos:doc-mail-mairie a owl:NamedIndividual, ant:Document ;
    rdfs:label "Courriel de demande de communication à la mairie"@fr ; ant:natureDocument skt:doc-courriel ;
    ant:urlSource "mail_mairie.txt"^^xsd:anyURI .
dos:doc-mail-matrice a owl:NamedIndividual, ant:Document ;
    rdfs:label "Courriel 6815-EM-SD au SDIF"@fr ; ant:natureDocument skt:doc-matrice ;
    ant:urlSource "mail_matrice_cadastrale.txt"^^xsd:anyURI .
dos:doc-mail-spf a owl:NamedIndividual, ant:Document ;
    rdfs:label "Courriel 3233-SD au SPF de Quimper"@fr ; ant:natureDocument skt:doc-spf ;
    ant:urlSource "mail_publicite_fonciere.txt"^^xsd:anyURI .
dos:doc-carte-covisibilite a owl:NamedIndividual, ant:Document ;
    rdfs:label "Carte de covisibilité manoir / parcelle"@fr ; ant:natureDocument skt:doc-preuve ;
    ant:urlSource "covisibilite_manoir_trevilit.jpg"^^xsd:anyURI .

# ═══════════════════════════════════════════════════════════════
#  PROCÉDURE, ÉVÉNEMENTS, DÉLAIS
# ═══════════════════════════════════════════════════════════════

dos:dp-29174-26-00122 a owl:NamedIndividual, ant:Procedure ;
    rdfs:label "DP 029 174 26 00122"@fr ; ant:numeroDossier "DP 029 174 26 00122" ;
    ant:demandeur dos:phoenix-france ;
    ant:instruitePar dos:mairie-ploneour ;
    ant:porteSurProjet dos:projet-pylone ;
    ant:pieceDuDossier dos:doc-avis-depot, dos:doc-dossier-dp .

dos:ev-depot a owl:NamedIndividual, ant:Evenement ;
    rdfs:label "Dépôt de la déclaration préalable"@fr ; ant:dateEvenement "2026-08-18"^^xsd:date ;
    ant:evenementDe dos:dp-29174-26-00122 ; ant:prouvePar dos:doc-avis-depot .

dos:ev-affichage-mairie a owl:NamedIndividual, ant:Evenement ;
    rdfs:label "Affichage de l'avis de dépôt en mairie"@fr ; ant:dateEvenement "2026-08-21"^^xsd:date ;
    ant:evenementDe dos:dp-29174-26-00122 ; ant:prouvePar dos:doc-avis-depot ;
    note:note "Cet affichage ne fait **pas** courir le délai de recours. Seul l'affichage sur le terrain le déclenche." .

dos:ev-decision a owl:NamedIndividual, ant:Evenement ;
    rdfs:label "Non-opposition tacite (date estimée)"@fr ; ant:dateEvenement "2026-09-18"^^xsd:date ;
    ant:evenementDe dos:dp-29174-26-00122 ;
    note:note "Estimation : un mois d'instruction à compter du dépôt. Décalée si des pièces complémentaires ont été demandées. **À confirmer auprès de la mairie.**" .

dos:ev-affichage-terrain a owl:NamedIndividual, ant:Evenement ;
    rdfs:label "Affichage sur le terrain — date inconnue"@fr ;
    ant:evenementDe dos:dp-29174-26-00122 ; ant:prouvePar dos:doc-panneau ;
    note:note "**Événement pivot de tout le calendrier contentieux.** Tant qu'il n'est ni daté ni prouvé, le délai de recours est réputé non déclenché." .

dos:delai-instruction a owl:NamedIndividual, ant:Delai ;
    rdfs:label "Délai d'instruction (1 mois)"@fr ; ant:duree "1 mois" ;
    ant:debuteLe "2026-08-18"^^xsd:date ; ant:expireLe "2026-09-18"^^xsd:date ;
    ant:declenchePar dos:ev-depot .

dos:delai-recours a owl:NamedIndividual, ant:Delai ;
    rdfs:label "Délai de recours contentieux (2 mois)"@fr ; ant:duree "2 mois" ;
    ant:declenchePar dos:ev-affichage-terrain ; ant:fondementDuDelai dos:art-r600-2 ;
    note:note "Non déclenché tant que l'affichage sur le terrain n'est pas constaté. Délai de forclusion, et non de prescription." .

dos:delai-notification a owl:NamedIndividual, ant:Delai ;
    rdfs:label "Notification du recours (15 jours)"@fr ; ant:duree "15 jours" ;
    ant:fondementDuDelai dos:art-r600-1 ;
    note:note "À peine d'irrecevabilité. Erreur la plus fréquente et la plus fatale des recours de riverains." .

dos:delai-retrait a owl:NamedIndividual, ant:Delai ;
    rdfs:label "Retrait d'une décision illégale (3 mois)"@fr ; ant:duree "3 mois" ;
    ant:declenchePar dos:ev-decision ; ant:fondementDuDelai dos:art-l424-5 .

# ═══════════════════════════════════════════════════════════════
#  MOYENS JURIDIQUES
# ═══════════════════════════════════════════════════════════════

dos:moyen-seuil-pc a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Emprise > 20 m² : un permis de construire était requis"@fr ;
    ant:fondementJuridique dos:art-r421-9 ; ant:etayePar dos:doc-dossier-dp ;
    ant:viseProcedure dos:dp-29174-26-00122 ; ant:force skt:force-forte ;
    note:note "Moyen le plus tranchant. Se vérifie sur le plan de masse : emprise cumulée de la dalle, des armoires, du coffret et de la zone clôturée." .

dos:moyen-talus a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Destruction de haies/talus protégés non déclarée"@fr ;
    ant:fondementJuridique dos:art-l151-23, dos:plu-art-6 ;
    ant:etayePar dos:doc-dossier-dp ; ant:viseProcedure dos:dp-29174-26-00122 ;
    ant:force skt:force-forte ;
    note:note "Deux linéaires protégés (121 m et 183 m) touchent la parcelle. Vérifier le tracé de l'accès sur le plan de masse." .

dos:moyen-zone-humide a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Atteinte à la zone humide voisine"@fr ;
    ant:fondementJuridique dos:art-l151-23 ; ant:etayeParMesure dos:m-dist-zone-humide ;
    ant:viseProcedure dos:dp-29174-26-00122 ; ant:force skt:force-a-verifier ;
    note:note "Dépend du tracé de la piste d'accès et de la gestion des eaux pluviales de la dalle. À trancher sur plans." .

dos:moyen-zone-a a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Violation des conditions de la zone A (paysage, activité agricole)"@fr ;
    ant:fondementJuridique dos:plu-regle-a-i-2-3 ;
    ant:etayeParMesure dos:m-covisibilite, dos:m-dist-maison1 ;
    ant:viseProcedure dos:dp-29174-26-00122 ; ant:force skt:force-moyenne ;
    note:note "Règle du PLU, donc plus solide qu'un standard général comme R. 111-27." .

dos:moyen-covisibilite a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Atteinte aux abords du Manoir de Trévilit"@fr ;
    ant:fondementJuridique dos:art-r111-27, dos:art-l621-30-patrimoine ;
    ant:etayeParMesure dos:m-covisibilite, dos:m-dist-manoir, dos:m-dist-abords ;
    ant:etayePar dos:doc-carte-covisibilite ;
    ant:viseProcedure dos:dp-29174-26-00122 ; ant:force skt:force-moyenne ;
    note:note "Moyen de renfort, jamais autonome : la parcelle est hors périmètre des abords. Apporte surtout un requérant crédible de plus." .

dos:moyen-affichage a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Irrégularité de l'affichage sur le terrain"@fr ;
    ant:fondementJuridique dos:art-r600-2 ; ant:etayePar dos:doc-panneau ;
    ant:viseProcedure dos:dp-29174-26-00122 ; ant:force skt:force-a-verifier ;
    note:note "N'annule pas l'autorisation, mais empêche le délai de courir. Le moyen qui achète du temps." .

dos:moyen-dim a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Absence de dossier d'information mairie"@fr ;
    ant:fondementJuridique dos:art-l34-9-1-cpce ; ant:viseProcedure dos:dp-29174-26-00122 ;
    ant:force skt:force-a-verifier ;
    note:note "La page « dossiers d'information » de la commune ne mentionne que deux dossiers de 2024. À vérifier auprès du service urbanisme." .

dos:moyen-ondes a owl:NamedIndividual, ant:MoyenJuridique ;
    rdfs:label "Exposition aux ondes / santé publique"@fr ;
    ant:fondementJuridique dos:ce-2011-ondes ; ant:viseProcedure dos:dp-29174-26-00122 ;
    ant:force skt:force-ecarte ;
    note:note "**Écarté volontairement.** La police des ondes appartient à l'État seul. Invoqué en contentieux d'urbanisme, ce moyen est rejeté et décrédibilise les autres. Conservé dans le graphe pour ne pas être reproposé." .

# ═══════════════════════════════════════════════════════════════
#  ACTIONS
# ═══════════════════════════════════════════════════════════════

dos:act-mail-mairie a owl:NamedIndividual, ant:Action ;
    rdfs:label "Envoyer la demande de communication à la mairie"@fr ;
    ant:menePar dos:vous ; ant:cible dos:mairie-ploneour ; ant:produit dos:doc-mail-mairie ;
    ant:soutient dos:moyen-seuil-pc, dos:moyen-talus, dos:moyen-dim ;
    ant:sousEcheanceDe dos:delai-instruction ;
    ant:statut skt:a-faire ; ant:echeance "2026-09-16"^^xsd:date .

dos:act-visite-mairie a owl:NamedIndividual, ant:Action ;
    rdfs:label "Se présenter au service urbanisme et consulter le dossier"@fr ;
    ant:menePar dos:vous ; ant:cible dos:mairie-ploneour ;
    ant:soutient dos:moyen-seuil-pc ; ant:statut skt:a-faire ; ant:echeance "2026-09-17"^^xsd:date ;
    note:note "Avant la décision, le dossier est un document préparatoire : un refus est licite. Revenir dès le 19 septembre." .

dos:act-relance-mairie a owl:NamedIndividual, ant:Action ;
    rdfs:label "Relancer la mairie si silence"@fr ;
    ant:menePar dos:vous ; ant:cible dos:mairie-ploneour ; ant:relance dos:act-mail-mairie ;
    ant:statut skt:a-faire ; ant:echeance "2026-09-23"^^xsd:date .

dos:act-mail-matrice a owl:NamedIndividual, ant:Action ;
    rdfs:label "Envoyer le 6815-EM-SD au SDIF"@fr ;
    ant:menePar dos:vous ; ant:cible dos:sdif-chateaulin ; ant:produit dos:doc-mail-matrice ;
    ant:statut skt:a-faire ; ant:echeance "2026-09-16"^^xsd:date .

dos:act-mail-spf a owl:NamedIndividual, ant:Action ;
    rdfs:label "Envoyer le 3233-SD au SPF de Quimper"@fr ;
    ant:menePar dos:vous ; ant:cible dos:spf-quimper ; ant:produit dos:doc-mail-spf ;
    ant:statut skt:a-faire ; ant:echeance "2026-09-16"^^xsd:date .

dos:act-photo-panneau a owl:NamedIndividual, ant:Action ;
    rdfs:label "Photographier le panneau daté, chaque semaine"@fr ;
    ant:menePar dos:vous ; ant:produit dos:doc-panneau ; ant:soutient dos:moyen-affichage ;
    ant:sousEcheanceDe dos:delai-recours ; ant:statut skt:a-faire ;
    note:note "Action récurrente. Un constat de commissaire de justice sécurise définitivement la preuve." .

dos:act-contact-proprietaire a owl:NamedIndividual, ant:Action ;
    rdfs:label "Rencontrer le propriétaire de la parcelle"@fr ;
    ant:menePar dos:vous ; ant:cible dos:proprietaire-yx26 ; ant:statut skt:a-faire ;
    note:note "L'action à plus fort effet de levier du dossier : un bail assorti d'une condition suspensive peut encore ne pas être levé. Approche courtoise impérative." .

dos:act-avocat a owl:NamedIndividual, ant:Action ;
    rdfs:label "Consulter un avocat en droit de l'urbanisme"@fr ;
    ant:menePar dos:vous ; ant:statut skt:a-faire ; ant:echeance "2026-09-22"^^xsd:date .

dos:act-sites-monuments a owl:NamedIndividual, ant:Action ;
    rdfs:label "Contacter Sites & Monuments"@fr ;
    ant:menePar dos:vous ; ant:cible dos:sites-et-monuments ; ant:soutient dos:moyen-covisibilite ;
    ant:statut skt:a-faire .

dos:act-udap a owl:NamedIndividual, ant:Action ;
    rdfs:label "Saisir l'UDAP pour un avis simple"@fr ;
    ant:menePar dos:proprietaire-manoir ; ant:cible dos:udap-29 ; ant:soutient dos:moyen-covisibilite ;
    ant:statut skt:a-faire .

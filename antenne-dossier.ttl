dos:maison-1 a owl:NamedIndividual, ant:Batiment ;
    rdfs:label "Habitation riveraine 1 (Kerfilin)"@fr ; ant:dansLieu dos:hameau-kerfilin ;
    ant:distanceParcelle 23 ;
    geo:asWKT "POINT(-4.27546 47.87469)"^^geo:wktLiteral .
dos:maison-2 a owl:NamedIndividual, ant:Batiment ;
    rdfs:label "Habitation riveraine 2 (Kerfilin)"@fr ; ant:dansLieu dos:hameau-kerfilin ;
    ant:distanceParcelle 32 ;
    geo:asWKT "POINT(-4.27572 47.87448)"^^geo:wktLiteral .
dos:maison-3 a owl:NamedIndividual, ant:Batiment ;
    rdfs:label "Habitation riveraine 3 (Kerfilin)"@fr ; ant:dansLieu dos:hameau-kerfilin ;

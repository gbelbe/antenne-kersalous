#!/usr/bin/env bash
# Refuse d'envoyer des commits qui n'ont pas l'identité personnelle autorisée.
# Activation : git config core.hooksPath .githooks   (voir PUBLICATION.md)
set -u
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                       # suppression de branche
  if [ "$remote_sha" = "$zero" ]; then range=("$local_sha" --not --remotes)   # nouvelle branche
  else range=("$remote_sha..$local_sha"); fi
  # réécriture d'historique (force-push) : on contrôle les commits propres au nouvel état
  git cat-file -e "$remote_sha^{commit}" 2>/dev/null || range=("$local_sha" --not --remotes)
  "$(git rev-parse --show-toplevel)/tools/check_identity.sh" "${range[@]}" || status=1
done
if [ $status -ne 0 ]; then
  echo
  echo "Push annulé. Corrigez l'identité (git config user.email …) puis réécrivez les commits :"
  echo "  git rebase -r --root --exec 'git commit --amend --no-edit --reset-author'"
  exit 1
fi
